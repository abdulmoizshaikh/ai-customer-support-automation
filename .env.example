# Compose-level configuration.
# Copy to .env and adjust. Do NOT commit .env.

# Postgres credentials (used by both the postgres service and the backend)
POSTGRES_USER=ai_support
POSTGRES_PASSWORD=ai_support
POSTGRES_DB=ai_support

# JWT secrets — change these in production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI providers inside the container (mock | openai)
# 'openai' expects Ollama running on the host at host.docker.internal:11434
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMS=768

# Ports exposed to the host
BACKEND_PORT=3000
FRONTEND_PORT=5173