DATABASE_URL="postgresql://ai_support:ai_support@localhost:5432/ai_support?schema=public"
PORT=3000

JWT_ACCESS_SECRET="ai-support-access-secret-change-me"
JWT_REFRESH_SECRET="ai-support-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# AI provider. mock | openai-compatible
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMS=768

# Business rules
REFUND_AUTO_LIMIT=500
REFUND_WINDOW_DAYS=30
AUTO_REFUND_THRESHOLD=500
CONFIDENCE_THRESHOLD=0.85